CREATE TABLE Products (ProductID INTEGER PRIMARY KEY, ProductName TEXT NOT NULL, Price REAL NOT NULL);
CREATE TABLE Sales (SaleID INTEGER PRIMARY KEY, ProductID INTEGER NOT NULL, QuantitySold INTEGER NOT NULL, SaleDate TEXT NOT NULL);
